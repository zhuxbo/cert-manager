APP_ENV=production
APP_DEBUG=false

# Laravel 应用标识；后台显示的站点名称在管理端系统设置中配置
# 多站点 Redis 隔离由 REDIS_DB / REDIS_CACHE_DB 完成，安装器不会修改此值
APP_NAME=ssl

# 系统时区（IANA 名称）影响所有时间写入与序列化输出
# 该值会同步到 mysql 连接的 session timezone
# 跨时区部署只需修改这一项，整条链路自动跟随
APP_TIMEZONE=Asia/Shanghai

APP_KEY=

# 数据库配置
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# 留空使用数据库服务器默认；安装器会按 MySQL / MariaDB 版本自动选择兼容排序规则
DB_COLLATION=

# 数据库备份保留策略；0 天表示不自动清理
# DB_BACKUP_KEEP_DAYS=30
# 即使超过保留天数，也至少保留最近的备份份数
# DB_BACKUP_MIN_KEEP=3

# JWT密钥
JWT_SECRET=

# Redis配置
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# 不使用 REDIS_URL：其中的 path/query 会覆盖数据库编号并破坏双库隔离
# 关键运行状态库：队列、业务锁、JWT 黑名单、限流与任务进度
# REDIS_DB=1
# 应用缓存库；还包含 Laravel 队列 pause/restart 与 scheduler mutex，不可整库清理
# 必须与 REDIS_DB 不同
# REDIS_CACHE_DB=2
# 同一 Redis 实例部署多个 Manager 时，每套都必须独占上述两个 DB
# Redis 连接与命令读取超时（秒）
# REDIS_TIMEOUT=5
# REDIS_READ_TIMEOUT=5

# 队列配置
# QUEUE_CONNECTION=redis
# 队列可见性超时必须大于插件任务超时与安全余量之和
# QUEUE_RETRY_AFTER=900

# 插件安装/更新：curl 与 HTTP fallback 各自最多下载 120 秒
# PLUGIN_DOWNLOAD_TIMEOUT=120
# UPGRADE_LEGACY_REQUEST_DRAIN_TIMEOUT=300
# PLUGIN_OPERATION_TIMEOUT=720
# PLUGIN_OPERATION_TIMEOUT_MARGIN=60

# 缓存配置
# CACHE_DRIVER=redis

# 数据库日志：最近 7 天保留全量脱敏记录，动作级审计保留 180 天
LOG_RETENTION_FULL_DAYS=7
LOG_RETENTION_AUDIT_DAYS=180
# storage/logs 按日日志文件保留天数
LOG_FILE_RETENTION_DAYS=14

# 运行时表保留期清理（schedule:purge 每日 02:00 清终态历史行；管理端列表页仅保留近保留期数据）
# tasks 最近全量窗口与动作审计窗口
# PURGE_RETENTION_TASKS_FULL_DAYS=7
# PURGE_RETENTION_TASKS_AUDIT_DAYS=180
# notifications 终态（sent/failed）保留天数，默认 90（>> 失败重发窗口）
# PURGE_RETENTION_NOTIFICATIONS_DAYS=90
# auto_deploy_reports 终态订单的自动部署上报记录保留天数，默认 90
# PURGE_RETENTION_AUTO_DEPLOY_REPORTS_DAYS=90
# 单批删除行数上限，默认 1000（分批 + 每批独立事务避免长事务/大 binlog）
# PURGE_CHUNK_SIZE=1000
