{
  "version": 1,
  "gates": {
    "make-test": {
      "command": ["make", "test"],
      "locks": ["backend-runtime:exclusive", "db:exclusive"]
    },
    "pint": {
      "command": [
        "docker",
        "compose",
        "exec",
        "-T",
        "app",
        "./vendor/bin/pint",
        "--test"
      ],
      "locks": ["backend-runtime:exclusive"]
    },
    "phpstan": {
      "command": [
        "docker",
        "compose",
        "exec",
        "-T",
        "app",
        "./vendor/bin/phpstan",
        "analyse",
        "--level=5",
        "--memory-limit=2G"
      ],
      "locks": ["backend-runtime:exclusive"]
    },
    "frontend-lint": {
      "command": ["pnpm", "lint:check"],
      "locks": ["frontend-root:shared"]
    },
    "frontend-tests": {
      "command": ["pnpm", "test:shared"],
      "locks": ["frontend-root:shared"]
    },
    "frontend-build": {
      "command": ["pnpm", "build"],
      "locks": ["frontend-root:exclusive"]
    },
    "executor-tests": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "skills/scripts/tests/test_finish_check_exec.py",
        "skills/scripts/tests/test_finish_check_files.py",
        "skills/scripts/tests/test_derive_scope_mutation.py",
        "skills/scripts/tests/test_mutation_shards.py",
        "skills/scripts/tests/test_mutate_targets.py",
        "skills/scripts/tests/test_release_plugin_isolation.py",
        "skills/scripts/tests/test_release_mutation_guard.py",
        "-v"
      ],
      "locks": []
    },
    "agent-guards": {
      "command": [
        "bash",
        "-lc",
        "set -euo pipefail\nmake check-agent-config\nbash skills/scripts/check-review-checklist-staleness.sh\nbash skills/scripts/finish-check-greps.sh\nbash skills/scripts/check-orphan-fixtures.sh"
      ],
      "locks": []
    },
    "compat-snapshot": {
      "command": [
        "docker",
        "compose",
        "exec",
        "-T",
        "-e",
        "DB_DATABASE=ssl_manager_test",
        "app",
        "composer",
        "test:snapshot"
      ],
      "locks": ["backend-runtime:exclusive", "db:exclusive"]
    },
    "mysql57": {
      "command": ["make", "test-mysql57"],
      "locks": ["backend-runtime:exclusive", "db:exclusive"]
    },
    "deploy-tests": {
      "command": [
        "bash",
        "-lc",
        "set -euo pipefail\nfor test_script in deploy/test/test-*.sh; do bash \"$test_script\"; done"
      ],
      "locks": []
    },
    "plugin-backend-tests": {
      "command": [
        "bash",
        "-lc",
        "set -euo pipefail\nfor suite in ../plugins/easy/backend/tests ../plugins/notice/backend/tests ../plugins/invoice/backend/tests ../plugins/cloud-deploy/backend/tests; do\n  docker compose exec -T -e DB_DATABASE=ssl_manager_test app php artisan test \"$suite\"\ndone"
      ],
      "locks": ["backend-runtime:exclusive", "db:exclusive"]
    },
    "plugin-cloud-deploy-package": {
      "command": [
        "bash",
        "plugins/release-plugin.sh",
        "cloud-deploy",
        "--version",
        "0.0.0-finish-check",
        "--build-only"
      ],
      "locks": ["plugin-cloud-deploy:exclusive"],
      "allowed_env": ["PNPM_ALLOW_NETWORK_FALLBACK"]
    },
    "plugin-invoice-package": {
      "command": [
        "bash",
        "plugins/release-plugin.sh",
        "invoice",
        "--version",
        "0.0.0-finish-check",
        "--build-only"
      ],
      "locks": ["plugin-invoice:exclusive"],
      "allowed_env": ["PNPM_ALLOW_NETWORK_FALLBACK"]
    },
    "main-package": {
      "command": [
        "bash",
        "build/build.sh",
        "--version",
        "0.0.0-finish-check",
        "--channel",
        "dev",
        "--package"
      ],
      "locks": ["package:exclusive"]
    },
    "package-invariants": {
      "command": [
        "bash",
        "-lc",
        "set -euo pipefail\nfor archive in build/temp/packages/ssl-manager-{full,upgrade,script}-0.0.0-finish-check.zip; do\n  test -s \"$archive\"\n  unzip -tq \"$archive\"\ndone\nif unzip -Z1 build/temp/packages/ssl-manager-full-0.0.0-finish-check.zip | grep -Ev '/$' | grep -Eq '^full/backend/storage/app/'; then exit 1; fi\necho PACKAGE_INVARIANTS_PASS"
      ],
      "locks": ["package:shared"]
    },
    "script-checks": {
      "command": ["python3", "skills/scripts/finish-check-files.py", "check"],
      "locks": []
    },
    "mutation": {
      "command": ["python3", "skills/scripts/mutation-shards.py", "run"],
      "locks": ["backend-runtime:exclusive", "db:exclusive"],
      "allowed_env": ["MUTATE_TARGET_CLASSES", "MUTATION_KEEP_WORKSPACE"]
    }
  }
}
