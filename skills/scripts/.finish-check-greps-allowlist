# --- W1 改密入口：均同方法/命令内调 revokeAllSessions 吊销会话（反模式 17 合规，已逐处亲验）---
ResetAdminPasswordCommand.php $admin->password = $password   # CLI 重置后调 revokeAllSessions
Admin/AuthController.php $admin->password = $request->input('newPassword')   # updatePassword 事务内 revokeAllSessions
User/AuthController.php $user->password = $newPassword   # updatePassword 事务内 revokeAllSessions
User/AuthController.php $user->password = $password   # resetPassword 事务内 revokeAllSessions

