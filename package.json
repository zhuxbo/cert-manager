{
  "name": "manager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --filter admin --filter user --parallel dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:user": "pnpm --filter user dev",
    "build:admin": "pnpm --filter admin build",
    "build:user": "pnpm --filter user build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm -r lint:check"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "lodash-es": "^4.18.1",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@commitlint/types": "^21.0.1"
  }
}
